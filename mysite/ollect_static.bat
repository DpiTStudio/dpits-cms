@echo off
chcp 65001 > nul
title Сбор статических файлов Django
echo ========================================
echo Сбор статических файлов для Django...
echo ========================================
echo.

REM Активируем виртуальное окружение (если используется)
call .venv\Scripts\activate

REM Переходим в директорию проекта (при необходимости)
cd /d L:\PYTHON\PROJECTS\dpits-cms\mysite

REM Выполняем сбор статики
echo Очистка старых и сбор новых статических файлов...
python manage.py collectstatic --noinput --clear

REM Проверяем результат
if %errorlevel% equ 0 (
    echo.
    echo ========================================
    echo УСПЕХ! Статические файлы собраны.
    echo ========================================
) else (
    echo.
    echo ========================================
    echo ОШИБКА! Не удалось собрать статические файлы.
    echo ========================================
)

echo.
echo Нажмите любую клавишу для выхода...
pause > nul